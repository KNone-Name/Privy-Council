      "model": "deepseek-chat",
      "temperature": 0.4,
      "max_tokens": 8192,
      "supports_tools": true,
      "timeout_s": 180
    },
    "ollama": {
      "label": "Ollama 本地",
      "base_url": "http://127.0.0.1:11434/v1",
